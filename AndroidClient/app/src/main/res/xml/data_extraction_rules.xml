<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). Same exclusions as backup_rules.xml,
     for both cloud backup and device-to-device transfer: allowBackup alone does
     not stop device-to-device transfer on Android 12+ (issue #89). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="paired_host.xml" />
        <exclude domain="sharedpref" path="device_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="paired_host.xml" />
        <exclude domain="sharedpref" path="device_identity.xml" />
    </device-transfer>
</data-extraction-rules>
